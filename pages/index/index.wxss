.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #0b0b0b;
  color: #ededed;
}

/* ---- top bar --------------------------------------------------------- */

.topbar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #111111;
}

.topbar-left,
.topbar-right {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
}

.topbar-brand {
  flex: 1 1 0%;
  min-width: 0;
  overflow: hidden;
  color: #8f7b5a;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-align: center;
  white-space: nowrap;
}

.top-button {
  height: 60rpx;
  margin: 0 4rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  color: #e6e6e6;
  font-size: 27rpx;
  line-height: 60rpx;
  white-space: nowrap;
}

.top-hover {
  opacity: 0.6;
}

.top-disabled {
  color: #5f5f5f;
}

.top-clear {
  color: #a9a9a9;
}

.top-save {
  background: #d6b98a;
  color: #211c15;
  font-weight: 600;
}

.top-save.top-disabled {
  background: #2a2a2a;
  color: #666666;
}

.top-icon {
  width: 60rpx;
  height: 60rpx;
  margin: 0 0 0 4rpx;
  border-radius: 30rpx;
  color: #bdbdbd;
  font-size: 36rpx;
  line-height: 60rpx;
  text-align: center;
}

/* ---- preview stage: the dominant area -------------------------------- */

.preview-stage {
  position: relative;
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
  overflow: hidden;
  background: #080808;
}

.frame-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.preview-canvas {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  background: #080808;
}

.empty-state {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 24rpx;
  right: 24rpx;
  transform: translateY(-50%);
  text-align: center;
  pointer-events: none;
}

.empty-icon {
  color: #6e6252;
  font-size: 88rpx;
  line-height: 1.2;
}

.empty-title {
  margin-top: 16rpx;
  color: #d2d2d2;
  font-size: 30rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  pointer-events: auto;
}

.empty-button {
  min-width: 220rpx;
  margin: 0 10rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1px solid #494949;
  border-radius: 44rpx;
  background: #232323;
  color: #e6e6e6;
  font-size: 27rpx;
  line-height: 84rpx;
  text-align: center;
}

.empty-primary {
  border-color: #d6b98a;
  background: #d6b98a;
  color: #211c15;
}

.empty-disabled {
  border-color: #353535;
  background: #202020;
  color: #696969;
}

.attribution {
  margin-top: 28rpx;
  color: #777777;
  font-size: 22rpx;
}

.loading-mask {
  position: absolute;
  z-index: 3;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.52);
  pointer-events: none;
}

.loading-text {
  margin-top: 16rpx;
  color: #ededed;
  font-size: 24rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: #d6b98a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.compare-badge {
  position: absolute;
  z-index: 6;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.72);
  color: #ffffff;
  font-size: 23rpx;
  pointer-events: none;
}

.initial-loading {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 40rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #bdbdbd;
  font-size: 23rpx;
  pointer-events: none;
}

/* ---- floating messages (top of the stage) ---------------------------- */

.overlays {
  position: absolute;
  z-index: 5;
  top: 16rpx;
  right: 20rpx;
  left: 20rpx;
  display: flex;
  flex-direction: column;
}

.error-banner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 16rpx 20rpx;
  border: 1px solid #77443f;
  border-radius: 12rpx;
  background: rgba(72, 43, 41, 0.95);
  color: #ffd8d2;
  font-size: 24rpx;
  line-height: 1.45;
}

.error-text {
  flex: 1 1 0%;
  min-width: 0;
  white-space: pre-wrap;
  word-break: break-all;
}

.error-close {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #e0a49c;
  font-size: 24rpx;
}

.export-card {
  margin-bottom: 12rpx;
  padding: 18rpx 22rpx;
  border: 1px solid #3a3326;
  border-radius: 12rpx;
  background: rgba(24, 22, 18, 0.94);
}

.export-card-error {
  border-color: #77443f;
  background: rgba(72, 43, 41, 0.95);
}

.export-text {
  color: #d6b98a;
  font-size: 23rpx;
}

.export-bar {
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #2b2b2b;
}

.export-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: #d6b98a;
  transition: width 0.18s linear;
}

.export-cancel {
  width: 100%;
  margin: 14rpx 0 0;
  border: 1px solid #4a4a4a;
  border-radius: 10rpx;
  background: #262626;
  color: #e6e6e6;
  font-size: 25rpx;
  line-height: 64rpx;
}

.export-cancel::after,
.export-mini::after {
  border: 0;
}

.export-error {
  color: #ffd8d2;
  font-size: 23rpx;
  line-height: 1.5;
}

.export-actions {
  display: flex;
  margin-top: 14rpx;
}

.export-mini {
  flex: 1 1 0%;
  margin: 0 8rpx 0 0;
  padding: 0;
  border: 1px solid #77443f;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.25);
  color: #ffe6e1;
  font-size: 24rpx;
  line-height: 60rpx;
}

/* ---- bottom dock: film strip + toolbar ------------------------------- */

.dock {
  position: relative;
  z-index: 10;
  flex: 0 0 auto;
  border-top: 1px solid #1f1f1f;
  background: #121212;
}

.strip-area {
  height: 212rpx;
}

.strip-scroll {
  width: 100%;
  height: 212rpx;
  white-space: nowrap;
}

.strip-inner {
  display: inline-flex;
  align-items: flex-start;
  height: 212rpx;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.strip-item {
  flex: 0 0 auto;
  width: 200rpx;
  margin-right: 16rpx;
}

.strip-item:last-child {
  margin-right: 0;
}

.thumb-box {
  position: relative;
  display: block;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
  overflow: hidden;
  border-radius: 10rpx;
  background: #080808;
}

.stock-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-glyph {
  color: rgba(255, 255, 255, 0.26);
  font-size: 40rpx;
}

.strip-selected .thumb-box {
  box-shadow: 0 0 0 3rpx #d6b98a;
}

.stock-name {
  margin-top: 12rpx;
  overflow: hidden;
  color: #9d9d9d;
  font-size: 22rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strip-selected .stock-name {
  color: #f2dfc0;
}

.strip-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 212rpx;
  color: #6f6f6f;
  font-size: 23rpx;
}

.toolbar {
  display: flex;
  height: 100rpx;
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #1f1f1f;
}

.tab {
  display: flex;
  flex: 1 1 0%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8c8c8c;
}

.tab-glyph {
  font-size: 34rpx;
  line-height: 1.2;
}

.tab-label {
  margin-top: 2rpx;
  font-size: 22rpx;
}

.tab-active {
  color: #d6b98a;
}

.tab-disabled {
  opacity: 0.35;
}

/* ---- bottom sheet (adjustments / effects) ---------------------------- */

.sheet {
  position: absolute;
  z-index: 20;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 1px);
  left: 0;
  display: flex;
  flex-direction: column;
  height: 520rpx;
  overflow: hidden;
  border-top: 1px solid #2a2a2a;
  border-radius: 24rpx 24rpx 0 0;
  background: #151515;
}

.sheet-header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx 0 28rpx;
}

.sheet-title {
  color: #f2dfc0;
  font-size: 28rpx;
  font-weight: 600;
}

.sheet-header-actions {
  display: flex;
  align-items: center;
}

.sheet-reset,
.sheet-close {
  margin: 0 0 0 8rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  color: #bdbdbd;
  font-size: 26rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.sheet-close {
  background: #d6b98a;
  color: #211c15;
}

.sheet-disabled {
  color: #555555;
}

/* The border picker is a short sheet: the photo keeps most of the stage. */
.sheet-compact {
  height: 330rpx;
}

.border-scroll {
  flex: 0 0 auto;
  width: 100%;
  height: 176rpx;
  white-space: nowrap;
}

.border-inner {
  display: inline-flex;
  align-items: flex-start;
  padding: 4rpx 20rpx 0;
}

.border-item {
  flex: 0 0 auto;
  width: 200rpx;
  margin-right: 16rpx;
}

.border-item:last-child {
  margin-right: 0;
}

.border-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 113rpx;
  overflow: hidden;
  border-radius: 10rpx;
  background: #080808;
}

.border-selected .border-slot {
  box-shadow: 0 0 0 3rpx #d6b98a;
}

.border-thumb {
  position: relative;
  flex: 0 0 auto;
  overflow: hidden;
}

.border-photo {
  position: absolute;
  overflow: hidden;
  background: linear-gradient(135deg, #5b6f80, #c8a67b);
}

.border-photo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.border-holes {
  position: absolute;
  right: 0;
  left: 0;
}

.border-name {
  margin-top: 12rpx;
  overflow: hidden;
  color: #9d9d9d;
  font-size: 22rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.border-selected .border-name {
  color: #f2dfc0;
}

.border-note {
  padding: 20rpx 28rpx 0;
  color: #767676;
  font-size: 20rpx;
  line-height: 1.4;
}

.sheet-scroll {
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
}

.sheet-body {
  padding: 0 28rpx 28rpx;
}

.slider-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  padding: 4rpx 0;
}

.slider-label {
  width: 120rpx;
  color: #cfcfcf;
  font-size: 25rpx;
}

.control-slider {
  flex: 1;
  margin: 0 10rpx;
}

.slider-value {
  width: 108rpx;
  color: #d6b98a;
  font-size: 23rpx;
  text-align: right;
}

.group-title {
  padding: 18rpx 0 4rpx;
  border-top: 1px solid #242424;
  color: #9fb6d4;
  font-size: 23rpx;
}

.group-note {
  padding: 8rpx 0 8rpx;
  color: #767676;
  font-size: 20rpx;
  line-height: 1.4;
}

.inline-note {
  padding: 6rpx 0 0;
  color: #b79a6e;
  font-size: 21rpx;
}

/* ---- about ----------------------------------------------------------- */

.about-modal {
  position: fixed;
  z-index: 90;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.about-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 80vh;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
  background: #1a1a1a;
}

.about-header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx 0 28rpx;
}

.about-title {
  color: #f2dfc0;
  font-size: 28rpx;
  font-weight: 600;
}

.about-close {
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: #2a2a2a;
  color: #dddddd;
  font-size: 25rpx;
  line-height: 56rpx;
  white-space: nowrap;
}

.about-scroll {
  flex: 1 1 0%;
  min-height: 0;
  max-height: 64vh;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.about-row {
  display: flex;
  padding: 8rpx 0;
}

.about-key {
  flex: 0 0 168rpx;
  color: #8f8f8f;
  font-size: 23rpx;
}

.about-value {
  flex: 1;
  color: #d4d4d4;
  font-size: 23rpx;
  line-height: 1.45;
}

.about-link {
  flex: 1;
  color: #d6b98a;
  font-size: 23rpx;
  line-height: 1.45;
}

.about-note {
  padding: 12rpx 0 0;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.45;
}

.about-diagnostic {
  flex: 1;
  margin: 0;
  border: 1px solid #554a38;
  border-radius: 8rpx;
  background: #29251f;
  color: #d6b98a;
  font-size: 22rpx;
  line-height: 52rpx;
}

.about-diagnostic::after,
.diagnostics-button::after,
.diagnostics-close::after {
  border: 0;
}

.diagnostics-modal {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.88);
}

.diagnostics-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 88vh;
  overflow: hidden;
  border: 1px solid #554a38;
  border-radius: 14rpx;
  background: #151515;
}

.diagnostics-header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1px solid #333333;
}

.diagnostics-title {
  color: #f2dfc0;
  font-size: 27rpx;
}

.diagnostics-close {
  width: 112rpx;
  margin: 0;
  background: #292929;
  color: #dddddd;
  font-size: 23rpx;
  line-height: 56rpx;
}

.diagnostics-scroll {
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
  padding: 16rpx;
  box-sizing: border-box;
}

.diagnostics-text {
  display: block;
  color: #d7d7d7;
  font-family: monospace;
  font-size: 19rpx;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-all;
}

.diagnostics-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #333333;
}

.diagnostics-button {
  flex: 1;
  margin: 0;
  border: 1px solid #6b5b41;
  border-radius: 8rpx;
  background: #30291f;
  color: #f2dfc0;
  font-size: 24rpx;
  line-height: 68rpx;
}

.diagnostics-button[disabled] {
  color: #777777;
  border-color: #333333;
  background: #222222;
}

.privacy-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.72);
}

.privacy-panel {
  width: 100%;
  max-width: 620rpx;
  padding: 32rpx 28rpx 24rpx;
  border: 1px solid #3a3a3a;
  border-radius: 18rpx;
  background: #1b1b1b;
  color: #ededed;
}

.privacy-title {
  color: #f2dfc0;
  font-size: 30rpx;
  font-weight: 600;
}

.privacy-body {
  margin-top: 16rpx;
  color: #c9c9c9;
  font-size: 25rpx;
  line-height: 1.6;
}

.privacy-name {
  margin-top: 12rpx;
  color: #d6b98a;
  font-size: 23rpx;
}

.privacy-note {
  margin-top: 12rpx;
  color: #e0a49c;
  font-size: 22rpx;
  line-height: 1.5;
}

.privacy-contract {
  margin-top: 20rpx;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: transparent;
  color: #d6b98a;
  font-size: 24rpx;
  line-height: 72rpx;
}

.privacy-contract::after {
  border: 0;
}

.privacy-actions {
  display: flex;
  margin-top: 20rpx;
}

.privacy-agree {
  flex: 1 1 auto;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #d6b98a;
  color: #211c15;
  font-size: 26rpx;
  line-height: 76rpx;
}

.privacy-agree::after {
  border: 0;
}

.privacy-refuse {
  flex: 1 1 auto;
  margin: 0;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: #262626;
  color: #e6e6e6;
  font-size: 26rpx;
  line-height: 76rpx;
}

.privacy-refuse::after {
  border: 0;
}

