<view class="page">
  <view class="header">
    <view class="title" bindlongpress="onOpenDiagnostics">SPEKTRAFILM</view>
    <view class="subtitle">胶片色彩 · 本机 WebGL 预览</view>
  </view>

  <view wx:if="{{error}}" class="error-banner" role="alert">{{error}}</view>

  <view
    id="previewStage"
    class="preview-stage {{hasPhoto ? 'has-photo' : 'empty-preview'}}"
    bindtouchstart="onPreviewTouchStart"
    bindtouchend="onPreviewTouchEnd"
    bindtouchcancel="onPreviewTouchCancel"
  >
    <canvas
      id="previewCanvas"
      type="webgl"
      class="preview-canvas"
      style="{{canvasStyle}}"
    ></canvas>

    <view wx:if="{{!hasPhoto}}" class="empty-state">
      <view class="empty-icon">▦</view>
      <view class="empty-title">选择一张照片开始</view>
      <view class="attribution">Film modeling powered by spektrafilm</view>
    </view>

    <view wx:if="{{busy && hasPhoto}}" class="loading-mask">
      <view class="loading-spinner"></view>
      <view class="loading-text">{{busyText}}</view>
    </view>
    <view wx:if="{{comparing}}" class="compare-badge">原始照片</view>
  </view>

  <scroll-view class="body-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="body-inner">

      <view class="section">
        <view class="section-header">
          <text class="section-title">胶片预设</text>
          <text class="section-hint">{{selectedStockName ? selectedStockName : '未选择'}}</text>
        </view>
        <view wx:for="{{categories}}" wx:for-item="category" wx:key="key" class="category">
          <view class="category-title">{{category.title}}</view>
          <view class="stock-grid">
            <view
              wx:for="{{category.stocks}}"
              wx:for-item="stock"
              wx:key="id"
              id="stock-{{stock.id}}"
              class="stock-card {{selectedStock === stock.id ? 'stock-selected' : ''}}"
              data-id="{{stock.id}}"
              bindtap="onStockTap"
            >
              <view class="thumb-box">
                <image
                  wx:if="{{stock.thumb.status === 'ready'}}"
                  class="stock-thumb"
                  src="{{stock.thumb.src}}"
                  mode="aspectFill"
                ></image>
                <view
                  wx:else
                  class="stock-thumb thumb-placeholder"
                  style="background-color: {{stock.thumb.color}}"
                >
                  <text class="thumb-glyph">▦</text>
                </view>
              </view>
              <view class="stock-info">
                <view class="stock-name">{{stock.name}}</view>
                <view class="stock-meta">ISO {{stock.iso}}</view>
                <view class="stock-desc">{{stock.description}}</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{!hasPhoto}}" class="section-empty">选择照片后显示各胶片预览</view>
      </view>

      <view class="section">
        <view class="section-header section-header-tap" bindtap="onToggleAdjustments">
          <text class="section-title">调整</text>
          <text class="section-chevron">{{adjustOpen ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{adjustOpen}}" class="section-body">
          <view class="slider-row">
            <text class="slider-label">曝光 EV</text>
            <slider
              class="control-slider"
              min="-2"
              max="2"
              step="0.1"
              value="{{adjustments.ev}}"
              data-key="ev"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onAdjustChanging"
              bindchange="onAdjustChange"
            />
            <text class="slider-value">{{readouts.ev}}</text>
          </view>
          <view class="slider-row">
            <text class="slider-label">色温</text>
            <slider
              class="control-slider"
              min="-100"
              max="100"
              step="1"
              value="{{adjustments.temperature}}"
              data-key="temperature"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onAdjustChanging"
              bindchange="onAdjustChange"
            />
            <text class="slider-value">{{readouts.temperature}}</text>
          </view>
          <view class="slider-row">
            <text class="slider-label">色调</text>
            <slider
              class="control-slider"
              min="-100"
              max="100"
              step="1"
              value="{{adjustments.tint}}"
              data-key="tint"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onAdjustChanging"
              bindchange="onAdjustChange"
            />
            <text class="slider-value">{{readouts.tint}}</text>
          </view>
          <view class="slider-row">
            <text class="slider-label">强度</text>
            <slider
              class="control-slider"
              min="0"
              max="1"
              step="0.01"
              value="{{adjustments.intensity}}"
              data-key="intensity"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onAdjustChanging"
              bindchange="onAdjustChange"
            />
            <text class="slider-value">{{readouts.intensity}}</text>
          </view>

          <view class="group-header section-header-tap" bindtap="onTogglePost">
            <text class="group-title">后期微调（非胶片物理）</text>
            <text class="section-chevron">{{postOpen ? '收起' : '展开'}}</text>
          </view>
          <view wx:if="{{postOpen}}" class="group-body">
            <view class="slider-row">
              <text class="slider-label">对比度</text>
              <slider
                class="control-slider"
                min="-1"
                max="1"
                step="0.01"
                value="{{adjustments.contrast}}"
                data-key="contrast"
                activeColor="#8fb0d6"
                backgroundColor="#3a3a3a"
                block-color="#cfe0f5"
                block-size="18"
                bindchanging="onAdjustChanging"
                bindchange="onAdjustChange"
              />
              <text class="slider-value">{{readouts.contrast}}</text>
            </view>
            <view class="slider-row">
              <text class="slider-label">饱和度</text>
              <slider
                class="control-slider"
                min="0"
                max="2"
                step="0.05"
                value="{{adjustments.saturation}}"
                data-key="saturation"
                activeColor="#8fb0d6"
                backgroundColor="#3a3a3a"
                block-color="#cfe0f5"
                block-size="18"
                bindchanging="onAdjustChanging"
                bindchange="onAdjustChange"
              />
              <text class="slider-value">{{readouts.saturation}}</text>
            </view>
            <view class="group-note">对比度与饱和度只改变显示观感，不属于胶片物理过程。</view>
          </view>

          <view wx:if="{{extendedLoading}}" class="inline-note">正在载入扩展 LUT…</view>

          <view class="panel-actions">
            <button
              class="reset-button"
              disabled="{{!resetEnabled}}"
              bindtap="onResetAdjustments"
            >重置</button>
          </view>
          <view class="panel-hint">按住预览查看原图，松开恢复胶片效果</view>
        </view>
      </view>

      <view class="section">
        <view class="section-header section-header-tap" bindtap="onToggleEffects">
          <text class="section-title">效果</text>
          <text class="section-chevron">{{effectsOpen ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{effectsOpen}}" class="section-body">
          <view class="slider-row">
            <text class="slider-label">颗粒</text>
            <slider
              class="control-slider"
              min="0"
              max="2"
              step="0.05"
              value="{{effects.grain}}"
              data-key="grain"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onEffectChanging"
              bindchange="onEffectChange"
            />
            <text class="slider-value">{{effectReadouts.grain}}</text>
          </view>
          <view class="slider-row">
            <text class="slider-label">光晕</text>
            <slider
              class="control-slider"
              min="0"
              max="2"
              step="0.05"
              value="{{effects.halation}}"
              data-key="halation"
              activeColor="#d6b98a"
              backgroundColor="#3a3a3a"
              block-color="#f2dfc0"
              block-size="18"
              bindchanging="onEffectChanging"
              bindchange="onEffectChange"
            />
            <text class="slider-value">{{effectReadouts.halation}}</text>
          </view>
          <view class="slider-row">
            <text class="slider-label">暗角</text>
            <slider
              class="control-slider"
              min="0"
              max="1"
              step="0.02"
              value="{{effects.vignette}}"
              data-key="vignette"
              activeColor="#8fb0d6"
              backgroundColor="#3a3a3a"
              block-color="#cfe0f5"
              block-size="18"
              bindchanging="onEffectChanging"
              bindchange="onEffectChange"
            />
            <text class="slider-value">{{effectReadouts.vignette}}</text>
          </view>
          <view class="group-note">颗粒与光晕是依据 spektrafilm 物理流程测得的近似效果，并非逐像素真实模拟；暗角为非物理的镜头暗角。预设缩略图不包含这些效果。</view>
          <view class="panel-actions">
            <button
              class="reset-button"
              bindtap="onResetEffects"
            >重置效果</button>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <text class="section-title">导出</text>
          <text class="section-hint">原图分辨率</text>
        </view>
        <view class="section-body">
          <view class="group-note">以原始分辨率导出当前胶片效果（最长边 4096 px，JPEG 92%）。原照片不会被修改，导出期间可随时取消。</view>
          <view wx:if="{{exporting}}" class="export-progress-box">
            <view class="export-text">{{exportText}}</view>
            <view class="export-bar">
              <view class="export-bar-fill" style="width: {{exportProgress}}%"></view>
            </view>
            <button class="export-cancel" bindtap="onCancelExport">取消</button>
          </view>
          <view class="panel-actions">
            <button
              class="reset-button export-button"
              disabled="{{!hasPhoto || exporting}}"
              bindtap="onSaveTap"
            >保存到相册</button>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header section-header-tap" bindtap="onToggleAbout">
          <text class="section-title">关于</text>
          <text class="section-chevron">{{aboutOpen ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{aboutOpen}}" class="section-body">
          <view class="about-row">
            <text class="about-key">色彩模拟</text>
            <text class="about-value">胶片模拟基于 spektrafilm（Andrea Volpato）</text>
          </view>
          <view class="about-row">
            <text class="about-key">项目地址</text>
            <text class="about-link" bindtap="onCopySourceUrl">{{sourceUrl}}</text>
          </view>
          <view class="about-row">
            <text class="about-key">许可</text>
            <text class="about-value">本项目代码以 GPLv3 发布；LUT 与色彩配置数据来自 spektrafilm，遵循 CC BY-SA 4.0（Andrea Volpato）。</text>
          </view>
          <view class="about-row">
            <text class="about-key">版本</text>
            <text class="about-value">{{version}}</text>
          </view>
          <view class="about-row">
            <text class="about-key">设备诊断</text>
            <button class="about-diagnostic" bindtap="onOpenDiagnostics">诊断</button>
          </view>
          <view class="about-note">颗粒与光晕为近似效果（详见 docs/EFFECTS.md）；扩散滤镜、耀光、锐化仍未包含。</view>
        </view>
      </view>

      <view class="body-tail"></view>
    </view>
  </scroll-view>

  <view wx:if="{{busy && !hasPhoto}}" class="initial-loading">
    <view class="loading-spinner"></view>
    <text>{{busyText}}</text>
  </view>

  <view class="actions">
    <button
      class="action-button primary-action"
      disabled="{{!ready || busy}}"
      data-source="album"
      bindtap="onChoosePhoto"
    >从相册选择</button>
    <button
      class="action-button"
      disabled="{{!ready || busy}}"
      data-source="camera"
      bindtap="onChoosePhoto"
    >拍照</button>
    <button wx:if="{{hasPhoto}}" class="clear-button" bindtap="onClearPhoto">清除</button>
  </view>

  <view wx:if="{{diagnosticsOpen}}" class="diagnostics-modal">
    <view class="diagnostics-panel">
      <view class="diagnostics-header">
        <text class="diagnostics-title">设备诊断</text>
        <button class="diagnostics-close" bindtap="onCloseDiagnostics">关闭</button>
      </view>
      <scroll-view class="diagnostics-scroll" scroll-y>
        <text class="diagnostics-text" selectable>{{diagnosticsText || '正在运行诊断…'}}</text>
      </scroll-view>
      <view class="diagnostics-actions">
        <button
          class="diagnostics-button"
          disabled="{{!diagnosticsAvailable}}"
          bindtap="onCopyDiagnostics"
        >复制</button>
        <button
          class="diagnostics-button"
          disabled="{{diagnosticsRunning}}"
          bindtap="onRerunDiagnostics"
        >重新运行</button>
      </view>
    </view>
  </view>
</view>
