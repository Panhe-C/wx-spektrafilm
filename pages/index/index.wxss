.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #141414;
  color: #ededed;
}

.header {
  flex: 0 0 auto;
  padding: 20rpx 32rpx 14rpx;
  background: #171717;
}

.title {
  color: #f2dfc0;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.subtitle {
  margin-top: 2rpx;
  color: #8c8c8c;
  font-size: 22rpx;
}

.error-banner {
  flex: 0 0 auto;
  padding: 16rpx 32rpx;
  border-top: 1px solid #77443f;
  border-bottom: 1px solid #77443f;
  background: #482b29;
  color: #ffd8d2;
  font-size: 25rpx;
}

.preview-stage {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  height: 42vh;
  min-height: 400rpx;
  overflow: hidden;
  background: #080808;
}

.empty-preview {
  /* Keep the native surface geometry unchanged across the first photo pick. */
  height: 42vh;
}

.preview-canvas {
  display: block;
  width: 100%;
  height: 100%;
  background: #080808;
}

.empty-state {
  position: absolute;
  top: 50%;
  left: 24rpx;
  right: 24rpx;
  transform: translateY(-50%);
  text-align: center;
  pointer-events: none;
}

.empty-icon {
  color: #6e6252;
  font-size: 72rpx;
  line-height: 1.2;
}

.empty-title {
  margin-top: 16rpx;
  color: #d2d2d2;
  font-size: 30rpx;
}

.attribution {
  margin-top: 14rpx;
  color: #777777;
  font-size: 22rpx;
}

.loading-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.52);
  pointer-events: none;
}

.loading-text {
  margin-top: 16rpx;
  color: #ededed;
  font-size: 24rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: #d6b98a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.compare-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.72);
  color: #ffffff;
  font-size: 23rpx;
  pointer-events: none;
}

.body-scroll {
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
}

.body-inner {
  padding: 0 20rpx;
}

.body-tail {
  height: 24rpx;
}

.section {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1px solid #262626;
  border-radius: 16rpx;
  background: #1c1c1c;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 14rpx 24rpx;
}

.section-header-tap {
  border-bottom: 1px solid #242424;
}

.section-title {
  color: #f2dfc0;
  font-size: 27rpx;
  font-weight: 600;
}

.section-hint {
  color: #8c8c8c;
  font-size: 22rpx;
}

.section-chevron {
  color: #8c8c8c;
  font-size: 22rpx;
}

.section-body {
  padding: 4rpx 24rpx 22rpx;
}

.section-empty {
  padding: 8rpx 24rpx 26rpx;
  color: #6f6f6f;
  font-size: 22rpx;
}

.category {
  padding-top: 18rpx;
}

.category-title {
  padding-bottom: 12rpx;
  color: #b9b9b9;
  font-size: 23rpx;
  letter-spacing: 2rpx;
}

.stock-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stock-card {
  width: 48.4%;
  margin-bottom: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border: 1px solid #2d2d2d;
  border-radius: 14rpx;
  background: #232323;
}

.stock-selected {
  border-color: #d6b98a;
  background: #32291f;
}

.thumb-box {
  position: relative;
  display: block;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
  overflow: hidden;
  border-radius: 10rpx;
  background: #080808;
}

.stock-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-glyph {
  color: rgba(255, 255, 255, 0.26);
  font-size: 40rpx;
}

.stock-info {
  padding: 12rpx 4rpx 4rpx;
}

.stock-name {
  overflow: hidden;
  color: #f0f0f0;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-meta {
  margin-top: 2rpx;
  color: #8f8f8f;
  font-size: 20rpx;
}

.stock-desc {
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 20rpx;
  line-height: 1.35;
}

.slider-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 6rpx 0;
}

.slider-label {
  width: 104rpx;
  color: #cfcfcf;
  font-size: 25rpx;
}

.control-slider {
  flex: 1;
  margin: 0 10rpx;
}

.slider-value {
  width: 108rpx;
  color: #d6b98a;
  font-size: 23rpx;
  text-align: right;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  margin-top: 10rpx;
  padding: 12rpx 0;
  border-top: 1px solid #242424;
}

.group-title {
  color: #9fb6d4;
  font-size: 24rpx;
}

.group-body {
  padding-bottom: 4rpx;
}

.group-note {
  padding: 2rpx 0 8rpx;
  color: #767676;
  font-size: 20rpx;
  line-height: 1.35;
}

.inline-note {
  padding: 6rpx 0 0;
  color: #b79a6e;
  font-size: 21rpx;
}

.panel-actions {
  padding-top: 18rpx;
}

.reset-button {
  width: 100%;
  margin: 0;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: #262626;
  color: #e6e6e6;
  font-size: 27rpx;
  line-height: 80rpx;
}

.reset-button::after {
  border: 0;
}

.reset-button[disabled] {
  border-color: #333333;
  background: #202020;
  color: #6a6a6a;
}

.panel-hint {
  padding-top: 14rpx;
  color: #737373;
  font-size: 21rpx;
  text-align: center;
}

.export-progress-box {
  padding: 16rpx 0 4rpx;
}

.export-text {
  color: #d6b98a;
  font-size: 23rpx;
}

.export-bar {
  height: 10rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #2b2b2b;
}

.export-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  background: #d6b98a;
  transition: width 0.18s linear;
}

.export-cancel {
  width: 100%;
  margin: 16rpx 0 0;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: #262626;
  color: #e6e6e6;
  font-size: 25rpx;
  line-height: 72rpx;
}

.export-cancel::after {
  border: 0;
}

.export-button {
  border-color: #d6b98a;
  background: #d6b98a;
  color: #211c15;
}

.export-button[disabled] {
  border-color: #333333;
  background: #202020;
  color: #6a6a6a;
}

.about-row {
  display: flex;
  padding: 8rpx 0;
}

.about-key {
  flex: 0 0 120rpx;
  color: #8f8f8f;
  font-size: 23rpx;
}

.about-value {
  flex: 1;
  color: #d4d4d4;
  font-size: 23rpx;
  line-height: 1.45;
}

.about-link {
  flex: 1;
  color: #d6b98a;
  font-size: 23rpx;
  line-height: 1.45;
}

.about-note {
  padding: 12rpx 0 0;
  color: #8a8a8a;
  font-size: 22rpx;
  line-height: 1.45;
}

.about-diagnostic {
  flex: 1;
  margin: 0;
  border: 1px solid #554a38;
  border-radius: 8rpx;
  background: #29251f;
  color: #d6b98a;
  font-size: 22rpx;
  line-height: 52rpx;
}

.about-diagnostic::after,
.diagnostics-button::after,
.diagnostics-close::after {
  border: 0;
}

.diagnostics-modal {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.88);
}

.diagnostics-panel {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 88vh;
  overflow: hidden;
  border: 1px solid #554a38;
  border-radius: 14rpx;
  background: #151515;
}

.diagnostics-header {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1px solid #333333;
}

.diagnostics-title {
  color: #f2dfc0;
  font-size: 27rpx;
}

.diagnostics-close {
  width: 112rpx;
  margin: 0;
  background: #292929;
  color: #dddddd;
  font-size: 23rpx;
  line-height: 56rpx;
}

.diagnostics-scroll {
  flex: 1 1 0%;
  height: 0;
  min-height: 0;
  padding: 16rpx;
  box-sizing: border-box;
}

.diagnostics-text {
  display: block;
  color: #d7d7d7;
  font-family: monospace;
  font-size: 19rpx;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-all;
}

.diagnostics-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #333333;
}

.diagnostics-button {
  flex: 1;
  margin: 0;
  border: 1px solid #6b5b41;
  border-radius: 8rpx;
  background: #30291f;
  color: #f2dfc0;
  font-size: 24rpx;
  line-height: 68rpx;
}

.diagnostics-button[disabled] {
  color: #777777;
  border-color: #333333;
  background: #222222;
}

.initial-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 18rpx;
  color: #bdbdbd;
  font-size: 23rpx;
}

.actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #262626;
  background: #181818;
}

.action-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  border: 1px solid #494949;
  border-radius: 12rpx;
  background: #2a2a2a;
  color: #e6e6e6;
  font-size: 27rpx;
  line-height: 84rpx;
}

.action-button::after,
.clear-button::after {
  border: 0;
}

.primary-action {
  border-color: #d6b98a;
  background: #d6b98a;
  color: #211c15;
}

.action-button[disabled] {
  border-color: #353535;
  background: #262626;
  color: #696969;
}

.clear-button {
  width: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: transparent;
  color: #a9a9a9;
  font-size: 25rpx;
  line-height: 84rpx;
}

.export-error {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border: 1px solid #77443f;
  border-radius: 10rpx;
  background: #482b29;
  color: #ffd8d2;
  font-size: 23rpx;
  line-height: 1.5;
}

.privacy-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.72);
}

.privacy-panel {
  width: 100%;
  max-width: 620rpx;
  padding: 32rpx 28rpx 24rpx;
  border: 1px solid #3a3a3a;
  border-radius: 18rpx;
  background: #1b1b1b;
  color: #ededed;
}

.privacy-title {
  color: #f2dfc0;
  font-size: 30rpx;
  font-weight: 600;
}

.privacy-body {
  margin-top: 16rpx;
  color: #c9c9c9;
  font-size: 25rpx;
  line-height: 1.6;
}

.privacy-name {
  margin-top: 12rpx;
  color: #d6b98a;
  font-size: 23rpx;
}

.privacy-note {
  margin-top: 12rpx;
  color: #e0a49c;
  font-size: 22rpx;
  line-height: 1.5;
}

.privacy-contract {
  margin-top: 20rpx;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: transparent;
  color: #d6b98a;
  font-size: 24rpx;
  line-height: 72rpx;
}

.privacy-contract::after {
  border: 0;
}

.privacy-actions {
  display: flex;
  margin-top: 20rpx;
}

.privacy-agree {
  flex: 1 1 auto;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #d6b98a;
  color: #211c15;
  font-size: 26rpx;
  line-height: 76rpx;
}

.privacy-agree::after {
  border: 0;
}

.privacy-refuse {
  flex: 1 1 auto;
  margin: 0;
  border: 1px solid #4a4a4a;
  border-radius: 12rpx;
  background: #262626;
  color: #e6e6e6;
  font-size: 26rpx;
  line-height: 76rpx;
}

.privacy-refuse::after {
  border: 0;
}

.export-actions {
  display: flex;
}

.export-actions .reset-button {
  flex: 1 1 auto;
  width: auto;
}

.export-actions .reset-button + .reset-button {
  margin-left: 16rpx;
}
